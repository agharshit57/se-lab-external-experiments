pipeline {
    agent any
    stages {
        stage('Start') {
            steps { echo 'Pipeline started' }
        }
        stage('Build') {
            steps {
                sh 'echo Building the sample application'
                sh 'mkdir -p output'
                sh 'echo Build successful > output/result.txt'
            }
        }
        stage('Verify') {
            steps { sh 'cat output/result.txt' }
        }
    }
    post {
        always { echo 'Pipeline execution finished' }
    }
}