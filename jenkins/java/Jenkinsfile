pipeline {
    agent any
    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build and Test') {
            steps {
                dir('maven/java-console') {
                    sh 'mvn clean test'
                }
            }
        }
        stage('Package') {
            steps {
                dir('maven/java-console') {
                    sh 'mvn package'
                }
            }
        }
    }
    post {
        success { echo 'Maven build successful' }
        failure { echo 'Build failed; inspect Console Output' }
    }
}