pipeline {
    agent any
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Versions') { steps { sh 'node --version'; sh 'npm --version' } }
        stage('Install') { steps { dir('jenkins/web') { sh 'npm install' } } }
        stage('Test') { steps { dir('jenkins/web') { sh 'npm test' } } }
    }
    post { success { echo 'Web checks passed' } failure { echo 'Web pipeline failed' } }
}
